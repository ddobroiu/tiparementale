# Baza de date partajata. DATABASE_URL foloseste rolul limitat la schema
# tipare_mentale; DATABASE_URL_ADMIN doar pentru migrari.
# Se completeaza automat de scripts/setup-db.mjs
DATABASE_URL=
DATABASE_URL_ADMIN=

# Anthropic - console.anthropic.com
ANTHROPIC_API_KEY=
# Org-level keys require the workspace header (anthropic-workspace-id)
ANTHROPIC_WORKSPACE_ID=

# Reglaj cost/calitate (optional, acestea sunt valorile implicite)
MODEL_REPLY=claude-sonnet-5
MODEL_EXTRACTION=claude-sonnet-5
MODEL_TRANSFORMATION=claude-opus-5
EXTRACTION_THRESHOLD=8
EFFORT_REPLY=low
EFFORT_EXTRACTION=medium
EFFORT_TRANSFORMATION=high

# Adresele conturilor care vad /admin, separate prin virgula
ADMIN_EMAILS=

# Resend - resend.com; domeniul tiparementale.ro trebuie verificat in cont
RESEND_API_KEY=
EMAIL_FROM=Tipare Mentale <contact@tiparementale.ro>

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Adresa canonica a site-ului (pentru sitemap, canonical, OG)
NEXT_PUBLIC_SITE_URL=https://tiparementale.ro
MODEL_PREDICTION=claude-sonnet-5
EFFORT_PREDICTION=medium

# Meta (Facebook) - Events Manager, dataset "Tipare Mentale - Pixel"
# ID-ul pixelului e public (ajunge in browser); tokenul NU.
NEXT_PUBLIC_META_PIXEL_ID=28179062978410852
# Events Manager -> dataset -> Settings -> Conversions API -> Generate access token
META_CAPI_ACCESS_TOKEN=
# Doar cat timp testezi: Events Manager -> Test events -> codul TESTxxxxx. Apoi lasa gol.
META_TEST_EVENT_CODE=

# Google Analytics 4 - proprietatea "Tipare Mentale", fluxul web tiparementale.ro
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-3GPDWSW82V

# Microsoft Clarity - se incarca doar cu acord analitic (implicit ID-ul din src/lib/clarity.ts)
NEXT_PUBLIC_CLARITY_ID=yplamurxjy

# TikTok Pixel - se incarca doar cu acord de marketing (implicit ID-ul din src/lib/tiktok.ts)
NEXT_PUBLIC_TIKTOK_PIXEL_ID=DATG2MRC77U0AVP512OG

# TikTok Events API (server): CompletePayment dupa plata, doar cu acord de marketing (src/lib/tiktok-events.ts)
# Token din TikTok Events Manager -> pixel -> Settings -> Generate Access Token; fara el nu se trimite nimic
TIKTOK_EVENTS_TOKEN=
# optional; implicit pixelul din src/lib/tiktok-events.ts
TIKTOK_PIXEL_ID=DATG2MRC77U0AVP512OG
# doar cat testezi (Events Manager -> Test events); in productie lasa gol
TIKTOK_TEST_EVENT_CODE=

# Cronul e-mailurilor de dupa inscriere (POST /api/cron/emails, vezi DEPLOY.md).
# Un sir aleator lung (ex.: openssl rand -hex 32); fara el (sau sub 16 caractere) ruta raspunde 401.
CRON_SECRET=

# mydashboard.ro citeste GET /api/mydashboard/stats cu antetul x-stats-token.
# Valoarea: HMAC-SHA256(CRON_SECRET din mydashboard, "stats:tiparementale") - vezi README-ul mydashboard.
# Fara ea, endpoint-ul raspunde 404.
MYDASHBOARD_STATS_TOKEN=

# "Continua cu Google" - Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorized redirect URI, exact: <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
# (productie: https://tiparementale.ro/api/auth/callback/google). Fara ambele, butonul nu apare si rutele raspund 404.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
